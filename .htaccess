# Landing "Pranzo sulla Domiziana" - regole per hosting Apache/LiteSpeed (Hostinger). GitHub Pages le ignora.

# La cartella e' indipendente dal resto del sito (anche se il sito e' WordPress): la pagina di ingresso e'
# index.html e le regole di riscrittura del sito principale non si applicano qui dentro.
DirectoryIndex index.html
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # recensioni.json passa da recensioni.php, che lo rinnova dalla scheda Google quando ha più di un giorno.
  RewriteRule ^recensioni\.json$ recensioni.php [L]
</IfModule>

# File di lavoro e configurazione: mai scaricabili (config.php viene comunque eseguito, non mostrato).
<FilesMatch "^(config\.php|config\.example\.php|recensioni-lib\.php|recensioni-escluse\.txt|recensioni\.lock|recensioni\.ultimo-tentativo|recensioni\.json\.tmp|README\.md|LICENSE|CLAUDE\.md|package\.json|\.gitignore|\.nojekyll|\.ftp-deploy-sync-state\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 404 /(\.github|\.git|scripts|src|data|docs|test|hostinger)(/|$)

# Il browser ricontrolla sempre le recensioni (il file cambia ogni giorno).
<IfModule mod_headers.c>
  <FilesMatch "^recensioni\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
